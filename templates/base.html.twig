<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Gestion Scolaire{% endblock %}</title>
        
        <!-- Intégration indispensable de Bootstrap 5 -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    </head>
    <body class="bg-light">

        <!-- Barre de navigation Bootstrap -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" href="{{ path('app_dashboard') }}">🎓 Gestion Scolaire</a>
                <div class="navbar-nav ms-auto flex-row gap-3">
                    <a class="nav-link text-white" href="{{ path('app_dashboard') }}">Accueil</a>
                    <a class="nav-link text-white" href="{{ path('app_eleves_index') }}">Élèves</a>
                    <a class="nav-link text-white" href="{{ path('app_classe_index') }}">Classes</a>
                    <a class="nav-link text-white" href="{{ path('app_enseignant_index') }}">Enseignants</a>
                    <a class="nav-link text-white" href="{{ path('app_cours_index') }}">Cours</a>
                    <a class="nav-link text-white" href="{{ path('app_note_index') }}">Notes</a>
                </div>
            </div>
        </nav>

        <!-- Contenu de la page -->
        <main class="container">
            {% block body %}{% endblock %}
        </main>

        <!-- Script Bootstrap JS -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    </body>
</html>