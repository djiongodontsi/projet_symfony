{% extends 'base.html.twig' %}

{% block title %}Liste des Classes{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-bold text-dark">🏫 Liste des Classes</h1>
        <a href="{{ path('app_classe_new') }}" class="btn btn-primary shadow-sm">+ Ajouter une classe</a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-dark text-uppercase fs-7">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Nom de la classe</th>
                        <th>Niveau</th>
                        <th>Année scolaire</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for classe in classes %}
                    <tr>
                        <td class="ps-4">{{ classe.id }}</td>
                        <td class="fw-semibold">{{ classe.nomClasse }}</td>
                        <td><span class="badge bg-secondary">{{ classe.niveau }}</span></td>
                        <td>{{ classe.anneeScolaire }}</td>
                        <td class="text-end pe-4">
                            <a href="{{ path('app_classe_show', {'id': classe.id}) }}" class="btn btn-sm btn-outline-info">Voir</a>
                            <a href="{{ path('app_classe_edit', {'id': classe.id}) }}" class="btn btn-sm btn-outline-warning">Modifier</a>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">Aucune classe trouvée.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}