{% extends 'base.html.twig' %}

{% block title %}Liste des Classes{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-bold text-dark">🏫 Liste des Classes</h1>
        <a href="{{ path('app_classe_new') }}" class="btn btn-primary shadow-sm">+ Ajouter une classe</a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-dark text-uppercase fs-7">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Nom de la classe</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>{% for cour in cours %}
    <tr>
        <td class="ps-4">{{ cour.id }}</td>
        <td class="fw-semibold">{{ cour.nomCours ?? cour.libelle ?? 'Cours #' ~ cour.id }}</td>
        <td class="text-end pe-4">
            <a href="{{ path('app_cours_show', {'id': cour.id}) }}" class="btn btn-sm btn-outline-info">Voir</a>
            <a href="{{ path('app_cours_edit', {'id': cour.id}) }}" class="btn btn-sm btn-outline-warning">Modifier</a>
        </td>
    </tr>
{% else %}
    <tr>
        <td colspan="3" class="text-center py-4 text-muted">Aucun cours trouvé.</td>
    </tr>
{% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}