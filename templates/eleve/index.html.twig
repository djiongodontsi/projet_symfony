{% extends 'base.html.twig' %}

{% block title %}Liste des élèves{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="h3 fw-bold text-dark mb-4">🎓 Liste des Élèves ({{ eleves|length }})</h1>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
        {# Formulaire de filtre par classe #}
        <form method="get" action="{{ path('app_eleve_index') }}" class="row g-3 mb-4 align-items-center">
              <div class="col-auto">
                 <label for="classe" class="col-form-label fw-bold">Filtrer par classe :</label>
    </div>
    <div class="col-auto">
        <select name="classe" id="classe" class="form-select" onchange="this.form.submit()">
            <option value="">Toutes les classes</option>
            {% for classe in classes %}
                {# Adaptez selon que vous stockez l'ID ou le nom de la classe #}
                <option value="{{ classe.id }}" {% if current_classe == classe.id %}selected{% endif %}>
    {{ classe.libelle }}
</option>
            {% endfor %}
        </select>
    </div>
</form>
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Email</th>
                        <th>Date de naissance</th>
                        <th>Classe</th>
                    </tr>
                </thead>
                <tbody>
                    {% for eleve in eleves %}
                        <tr>
                            <td>{{ eleve.id }}</td>
                            <td>{{ eleve.nom }}</td>
                            <td>{{ eleve.prenom }}</td>
                            <td>{{ eleve.email }}</td>
                            <td>{{ eleve.dateNaissance ? eleve.dateNaissance|date('d/m/Y') : '-' }}</td>
                            <td>{{ eleve.classe ? eleve.classe.nomClasse : '-' }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Aucun élève trouvé</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="text-center mt-4">
        <a href="{{ path('app_eleve_new') }}" class="btn btn-primary btn-lg shadow-sm">+ Créer un élève</a>
    </div>
</div>
{% endblock %}