{% extends 'base.html.twig' %}

{% block title %}Liste des Élèves{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-bold text-dark">🎓 Liste des Élèves</h1>
       <a href="{{ path('app_eleve_new') }}" class="btn btn-primary shadow-sm">+ Ajouter un élève</a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-dark text-uppercase fs-7">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Nom & Prénom</th>
                        <th>Email</th>
                        <th>Classe</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for eleve in eleves %}
                        <tr>
                            <td class="ps-4">{{ eleve.id }}</td>
                            <td class="fw-semibold">{{ eleve.nom }} {{ eleve.prenom }}</td>
                            <td>{{ eleve.email }}</td>
                            <td>
                                {% if eleve.classe %}
                                    <span class="badge bg-secondary">{{ eleve.classe.nomClasse }}</span>
                                {% else %}
                                    <span class="text-muted">Aucune</span>
                                {% endif %}
                            </td>
                            <td class="text-end pe-4">
                                <a href="{{ path('app_eleves_show', {'id': eleve.id}) }}" class="btn btn-sm btn-outline-info">Voir</a>
                                <a href="{{ path('app_eleves_edit', {'id': eleve.id}) }}" class="btn btn-sm btn-outline-warning">Modifier</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Aucun élève trouvé.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}