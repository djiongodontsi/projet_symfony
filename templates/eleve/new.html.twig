{% extends 'base.html.twig' %}

{% block title %}Nouvel élève{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="h3 fw-bold mb-4">Ajouter un élève</h1>
    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button class="btn btn-primary mt-3">Enregistrer</button>
        <a href="{{ path('app_eleve_index') }}" class="btn btn-secondary mt-3">Annuler</a>
    {{ form_end(form) }}
</div>
{% endblock %}