<form method="post" action="{{ path('app_enseignant_delete', {'id': enseignant.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ enseignant.id) }}">
    <button class="btn btn-sm btn-outline-danger">Supprimer</button>
</form>